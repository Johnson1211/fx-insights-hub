datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "linux-musl-openssl-3.0.x"]
}

enum Role {
  guest
  member
  trader
  admin
}

enum Plan {
  free
  premium
  copy_trader
  training
}

enum DerivStatus {
  unsubmitted
  pending
  approved
  rejected
}

enum Experience {
  beginner
  intermediate
  advanced
}

enum SignalType {
  BUY
  SELL
}

enum Timeframe {
  M15
  H1
  H4
  D1
}

enum SignalStatus {
  Active
  Closed
}

enum SignalResult {
  Win
  Loss
  Breakeven
}

enum Platform {
  youtube
  zoom
  custom
}

enum BlogPostStatus {
  draft
  published
}

model User {
  id                    String            @id @default(uuid())
  name                  String
  email                 String            @unique
  password              String
  phone                 String?
  avatar                String?           @default("")
  role                  Role              @default(guest)
  plan                  Plan              @default(free)
  tradingExperience     Experience?
  referralCode          String            @unique
  referredBy            String?
  isVerified            Boolean           @default(false)
  derivId               String?           @unique
  derivStatus           DerivStatus       @default(unsubmitted)
  brokerApproved        Boolean           @default(false)
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  signals               Signal[]
  videos                Video[]
  blogPosts             BlogPost[]
  liveSessions          LiveSession[]
  userNotifications     UserNotification[]
  bookings              Booking[]
  forumPosts            ForumPost[]
  forumComments         ForumComment[]
  signalComments        SignalComment[]
  signalLikes           SignalLike[]
  blogLikes             BlogLike[]
}

model Signal {
  id          String        @id @default(uuid())
  pair        String
  type        SignalType
  entryPrice  Float
  stopLoss    Float
  takeProfit1 Float
  takeProfit2 Float?
  timeframe   Timeframe
  volatilityIndex String?
  analysis    String
  chartImage  String?
  status      SignalStatus  @default(Active)
  result      SignalResult?
  pips        Float?
  views       Int           @default(0)
  createdBy   String
  creator     User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  closedAt    DateTime?
  comments    SignalComment[]
  likes       SignalLike[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}


model Video {
  id            String   @id @default(uuid())
  title         String
  description   String
  thumbnail     String
  url           String
  category      String
  tags          String[]
  isFreePreview Boolean  @default(false)
  duration      Int      @default(0)
  order         Int      @default(0)
  views         Int      @default(0)
  createdBy     String
  creator       User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BlogPost {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  excerpt     String
  content     String
  coverImage  String
  category    String
  tags        String[]
  publishedAt DateTime       @default(now())
  authorId    String
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  status      BlogPostStatus @default(draft)
  likes       BlogLike[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model LiveSession {
  id           String    @id @default(uuid())
  title        String
  description  String?
  scheduledAt  DateTime
  platform     Platform
  embedUrl     String
  isLive       Boolean   @default(false)
  recordingUrl String?
  createdBy    String
  creator      User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Setting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("info") // "info", "warning", "success", "alert"
  link      String?  // Optional redirection URL
  isPinned  Boolean  @default(false)  // Top banner alert
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Per-user personal notifications (e.g. course approval alerts)
model UserNotification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // "info", "success", "warning", "alert"
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Booking {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // "bootcamp" | "classroom" | "mentorship"
  status        String   @default("pending") // "pending" | "confirmed" | "cancelled"
  preferredDate DateTime
  notes         String?
  createdAt     DateTime @default(now())
}

model ForumPost {
  id         String         @id @default(uuid())
  title      String
  content    String         // markdown content
  chartImage String?
  category   String         // e.g. "Forex" | "Indices" | "Crypto" | "General"
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments   ForumComment[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model ForumComment {
  id        String    @id @default(uuid())
  content   String
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model SignalComment {
  id        String   @id @default(uuid())
  content   String
  signalId  String
  signal    Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model SignalLike {
  id        String   @id @default(uuid())
  signalId  String
  signal    Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([signalId, userId])
}

model BlogLike {
  id        String   @id @default(uuid())
  blogId    String
  blog      BlogPost @relation(fields: [blogId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blogId, userId])
}
